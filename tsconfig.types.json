{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    // `import {} from './radix'` in lib/radix.d.ts (and the other lib/*.d.ts)
    // must keep resolving to the hand written definition itself, not to the
    // lib/radix.ts source next to it: look for X.d.ts before X.ts.
    "moduleSuffixes": [".d", ""],
  },
  "include": [
    // only compile the type definitions by default.
    // That is, ignore the files in 'examples/**'
    "**/*.d.ts"
  ],
  "exclude": [
    // Among the type definitions, don't try to compile
    // the test file which implements bad types.
    // It implements bad types for testing purposes.
    "**/*.test-d.ts"
  ]
}
